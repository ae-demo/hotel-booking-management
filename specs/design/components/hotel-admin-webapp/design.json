  "description": "The hotel back-office web application for Hotel Manager/Admin, Front Desk Staff and Channel Manager Operator: property/room/rate configuration, staff management, reservation management, check-in/check-out, channel connections and sync monitoring, and reports. Does not serve guest-facing booking screens — those live in guest-webapp.",
  "dependencies": [
    {
      "kind": "component",
      "name": "hotel-api",
      "wiring": {
        "endpoint": {
          "component": "hotel-booking-management-hotel-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "HOTEL_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "hotel-booking-man-5931b6cc",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
