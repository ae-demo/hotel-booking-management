{
  "name": "guest-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "guest-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    13,
    14,
    15,
    16
  ],
  "description": "The guest-facing booking site: search rooms, book and pay online, sign in, view/cancel own reservations. Does not expose any property/rate configuration or channel-management screens — those live in hotel-admin-webapp.",
  "dependencies": [
    {
      "kind": "component",
      "name": "hotel-api",
      "wiring": {
        "endpoint": {
          "component": "hotel-booking-management-hotel-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "HOTEL_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "hotel-booking-man-5931b6cc",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
